+
+private let blueTagSlowModeOptions: [Int32] = [0, 10, 30, 60, 300]
+private let blueTagDurationOptions: [Int32] = [86400, 7 * 86400, 0]
+private let blueTagLimitOptions: [Int32] = [10, 50, 0]
+
+private struct BlueTagDraft: Equatable {
+    var isEnabled: Bool = false
+    var freeMessages: Bool = true
+    var slowModeIndex: Int = 2
+    var durationIndex: Int = 1
+    var limitIndex: Int = 1
+
+    init() {
+    }
+
+    init(perks: TelegramChatMemberTagPerks, timestamp: Int32) {
+        self.isEnabled = true
+        self.freeMessages = perks.freeMessages
+        self.slowModeIndex = blueTagSlowModeOptions.firstIndex(of: perks.slowmodeSeconds) ?? 2
+        if perks.untilDate == 0 {
+            self.durationIndex = 2
+        } else {
+            self.durationIndex = perks.untilDate - timestamp > 86400 ? 1 : 0
+        }
+        self.limitIndex = blueTagLimitOptions.firstIndex(of: perks.messagesLimit) ?? 1
+    }
+
+    func perks(timestamp: Int32) -> TelegramChatMemberTagPerks? {
+        guard self.isEnabled else {
+            return nil
+        }
+        let duration = blueTagDurationOptions[self.durationIndex]
+        return TelegramChatMemberTagPerks(
+            freeMessages: self.freeMessages,
+            slowmodeSeconds: blueTagSlowModeOptions[self.slowModeIndex],
+            untilDate: duration == 0 ? 0 : timestamp + duration,
+            messagesLimit: blueTagLimitOptions[self.limitIndex]
+        )
+    }
+}
+
+private func blueTagSlowModeTitle(_ seconds: Int32) -> String {
+    if seconds == 0 {
+        return strings().blueTagOff
+    } else if seconds < 60 {
+        return strings().blueTagSecondsShort("\(seconds)")
+    } else {
+        return strings().blueTagMinutesShort("\(seconds / 60)")
+    }
+}
+
+private func blueTagDurationTitle(_ duration: Int32) -> String {
+    if duration == 0 {
+        return strings().blueTagForever
+    } else if duration == 86400 {
+        return strings().blueTagDay1
+    } else {
+        return strings().blueTagDays7
+    }
+}
+
+private func blueTagLimitTitle(_ limit: Int32) -> String {
+    return limit == 0 ? strings().blueTagNoLimit : "\(limit)"
+}
 
