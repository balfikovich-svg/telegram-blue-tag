diff --git a/src/util/blueTagEmulation.ts b/src/util/blueTagEmulation.ts
new file mode 100644
index 0000000..b87e335
--- /dev/null
+++ b/src/util/blueTagEmulation.ts
@@ -0,0 +1,13 @@
+// Blue Tag is a proposed API (see SPEC.md). Until the server supports it, the client can emulate it locally:
+//   localStorage.setItem('tt-blue-tag-emulation', '1')
+// Admin side: Edit Member Tag saves the perks locally instead of calling channels.editMemberTagPerks.
+// Member side: window.blueTag.setMyPerks(chatId, { isFreeMessages: true, slowModeSeconds: 5, messagesLimit: 50 }).
+const STORAGE_KEY = 'tt-blue-tag-emulation';
+
+export function isBlueTagEmulationEnabled() {
+  try {
+    return localStorage.getItem(STORAGE_KEY) === '1';
+  } catch {
+    return false;
+  }
+}
