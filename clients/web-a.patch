+export function updateChatMemberTagPerks<T extends GlobalState>(
+  global: T, chatId: string, userId: string, perks?: ApiChatMemberTagPerks,
+): T {
+  if (userId === global.currentUserId) {
+    global = updateChat(global, chatId, { tagPerks: perks });
+  }
+
+  const fullInfo = selectChatFullInfo(global, chatId);
+  if (!fullInfo?.members) {
+    return global;
+  }
+
+  let isChanged = false;
+  const members = fullInfo.members.map((member) => {
+    if (member.userId !== userId) return member;
+    isChanged = true;
+    return { ...member, tagPerks: perks };
+  });
+
+  return isChanged ? updateChatFullInfo(global, chatId, { members }) : global;
+}
