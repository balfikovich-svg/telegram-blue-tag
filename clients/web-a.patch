@@ -0,0 +1,29 @@
+import type { ApiChatMemberTagPerks } from '../../api/types';
+
+import { getServerTime } from '../../util/serverTime';
+
+export const BLUE_TAG_PEER_COLOR = 5;
+export const BLUE_TAG_SLOW_MODE_OPTIONS = [0, 10, 30, 60, 300];
+export const BLUE_TAG_DURATION_OPTIONS = [86400, 7 * 86400, 0];
+export const BLUE_TAG_LIMIT_OPTIONS = [10, 50, 0];
+
+export function isTagPerksActive(perks?: ApiChatMemberTagPerks, now = getServerTime()): perks is ApiChatMemberTagPerks {
+  if (!perks) return false;
+  if (perks.untilDate && perks.untilDate <= now) return false;
+  if (perks.messagesLimit && (perks.messagesUsed || 0) >= perks.messagesLimit) return false;
+  return true;
+}
+
+export function getTagPerksMessagesLeft(perks?: ApiChatMemberTagPerks) {
+  if (!perks?.messagesLimit) return undefined;
+  return Math.max(0, perks.messagesLimit - (perks.messagesUsed || 0));
+}
+
+export function areTagPerksFree(perks?: ApiChatMemberTagPerks) {
+  return isTagPerksActive(perks) && Boolean(perks.isFreeMessages);
+}
+
+export function consumeTagPerksMessage(perks: ApiChatMemberTagPerks): ApiChatMemberTagPerks | undefined {
+  const updated = { ...perks, messagesUsed: (perks.messagesUsed || 0) + 1 };
+  return isTagPerksActive(updated) ? updated : undefined;
+}
