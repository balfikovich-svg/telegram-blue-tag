+++ b/src/global/helpers/blueTag.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  areTagPerksFree, consumeTagPerksMessage, getTagPerksMessagesLeft, isTagPerksActive,
+} from './blueTag';
+
+const NOW = 1_800_000_000;
+
+describe('Blue Tag perks', () => {
+  it('is active without limits', () => {
+    expect(isTagPerksActive({ isFreeMessages: true }, NOW)).toBe(true);
+    expect(isTagPerksActive(undefined, NOW)).toBe(false);
+  });
+
+  it('expires by date', () => {
+    expect(isTagPerksActive({ untilDate: NOW + 1 }, NOW)).toBe(true);
+    expect(isTagPerksActive({ untilDate: NOW }, NOW)).toBe(false);
+  });
+
+  it('expires by message limit', () => {
+    expect(isTagPerksActive({ messagesLimit: 50, messagesUsed: 49 }, NOW)).toBe(true);
+    expect(isTagPerksActive({ messagesLimit: 50, messagesUsed: 50 }, NOW)).toBe(false);
+  });
+
+  it('counts messages left', () => {
+    expect(getTagPerksMessagesLeft({ messagesLimit: 50, messagesUsed: 1 })).toBe(49);
+    expect(getTagPerksMessagesLeft({ isFreeMessages: true })).toBeUndefined();
+  });
+
+  it('drops perks after the last free message', () => {
+    expect(consumeTagPerksMessage({ isFreeMessages: true, messagesLimit: 2, messagesUsed: 0 }))
+      .toEqual({ isFreeMessages: true, messagesLimit: 2, messagesUsed: 1 });
+    expect(consumeTagPerksMessage({ isFreeMessages: true, messagesLimit: 1, messagesUsed: 0 })).toBeUndefined();
+  });
+
+  it('only free perks skip payment', () => {
+    expect(areTagPerksFree({ slowModeSeconds: 30 })).toBe(false);
+    expect(areTagPerksFree({ isFreeMessages: true })).toBe(true);
+  });
+});
