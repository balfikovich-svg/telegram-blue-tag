diff --git a/src/lib/gramjs/tl/blueTag.test.ts b/src/lib/gramjs/tl/blueTag.test.ts
new file mode 100644
index 0000000..7d893c9
--- /dev/null
+++ b/src/lib/gramjs/tl/blueTag.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest';
+
+import { Api } from '..';
+import { BinaryReader } from '../extensions';
+
+function roundTrip<T>(object: { getBytes(): Uint8Array }): T {
+  return new BinaryReader(object.getBytes()).tgReadObject() as T;
+}
+
+describe('Blue Tag TL', () => {
+  it('uses CRC32 constructor ids from SPEC.md', () => {
+    expect(Api.ChatMemberTagPerks.CONSTRUCTOR_ID).toBe(0x78b4ccb0);
+    expect(Api.ChannelParticipant.CONSTRUCTOR_ID).toBe(0xb8123bc8);
+    expect(Api.channels.EditMemberTagPerks.CONSTRUCTOR_ID).toBe(0x72de3d23);
+  });
+
+  it('round-trips channelParticipant.tag_perks', () => {
+    const participant = new Api.ChannelParticipant({
+      userId: BigInt(42) as any,
+      date: 1_700_000_000,
+      rank: 'bug hunter',
+      tagPerks: new Api.ChatMemberTagPerks({
+        freeMessages: true,
+        slowmodeSeconds: 30,
+        untilDate: 1_800_000_000,
+        messagesLimit: 50,
+        messagesUsed: 1,
+      }),
+    });
+
+    const parsed = roundTrip<Api.ChannelParticipant>(participant);
+    expect(parsed.rank).toBe('bug hunter');
+    expect(parsed.tagPerks?.freeMessages).toBe(true);
+    expect(parsed.tagPerks?.slowmodeSeconds).toBe(30);
+    expect(parsed.tagPerks?.messagesLimit).toBe(50);
+    expect(parsed.tagPerks?.messagesUsed).toBe(1);
+  });
+
+  it('keeps perks optional', () => {
+    const parsed = roundTrip<Api.ChannelParticipant>(new Api.ChannelParticipant({
+      userId: BigInt(42) as any,
+      date: 1,
+    }));
+    expect(parsed.tagPerks).toBeUndefined();
+  });
+});
