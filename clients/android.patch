@@ -0,0 +1,97 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+
+/**
+ * Blue Tag (see SPEC.md): a member tag with perks an admin gave — free messages in a group with
+ * paid messages, a personal slow mode, for a time or a number of messages. Drawn in peer color 5.
+ */
+public final class BlueTag {
+
+    public static final int[] SLOW_MODE_OPTIONS = { 0, 10, 30, 60, 300 };
+    public static final int[] DURATION_OPTIONS = { 86400, 7 * 86400, 0 };
+    public static final int[] LIMIT_OPTIONS = { 10, 50, 0 };
+
+    private BlueTag() {}
+
+    public static boolean isActive(TLRPC.TL_chatMemberTagPerks perks, int now) {
+        if (perks == null) return false;
+        if (perks.until_date != 0 && perks.until_date <= now) return false;
+        return perks.messages_limit == 0 || perks.messages_used < perks.messages_limit;
+    }
+
+    /** My perks in this chat, while they last; delivered on the channel like admin_rights */
+    public static TLRPC.TL_chatMemberTagPerks getMyActivePerks(int account, TLRPC.Chat chat) {
+        if (chat == null || chat.tag_perks == null) return null;
+        final int now = ConnectionsManager.getInstance(account).getCurrentTime();
+        return isActive(chat.tag_perks, now) ? chat.tag_perks : null;
+    }
+
+    public static boolean isFree(int account, TLRPC.Chat chat) {
+        final TLRPC.TL_chatMemberTagPerks perks = getMyActivePerks(account, chat);
+        return perks != null && perks.free_messages;
+    }
+
+    /** -1 when there is no limit */
+    public static int getMessagesLeft(TLRPC.TL_chatMemberTagPerks perks) {
+        if (perks == null || perks.messages_limit == 0) return -1;
+        return Math.max(0, perks.messages_limit - perks.messages_used);
+    }
+
+    /**
+     * One of my messages reached the server: counted at once (the next channel update brings the true
+     * count). Returns the personal slow mode in seconds, 0 for none, or -1 when I have no perks here
+     */
+    public static int onMessageSent(int account, TLRPC.Chat chat) {
+        final TLRPC.TL_chatMemberTagPerks perks = getMyActivePerks(account, chat);
+        if (perks == null) return -1;
+        perks.messages_used++;
+        return perks.slowmode_seconds;
+    }
+
+    public static TLRPC.TL_chatMemberTagPerks make(boolean freeMessages, int slowModeSeconds, int duration, int messagesLimit, int now) {
+        final TLRPC.TL_chatMemberTagPerks perks = new TLRPC.TL_chatMemberTagPerks();
+        perks.free_messages = freeMessages;
+        perks.slowmode_seconds = slowModeSeconds;
+        perks.until_date = duration != 0 ? now + duration : 0;
+        perks.messages_limit = messagesLimit;
+        return perks;
+    }
+
+    /** Whether I may give this member perks: a supergroup's admin who can ban, for a member who is not an admin */
+    public static boolean canEdit(TLRPC.Chat chat, TLRPC.User user, boolean admin, boolean owner) {
+        return ChatObject.isChannel(chat) && chat.megagroup && !admin && !owner
+            && user != null && !UserObject.isUserSelf(user) && ChatObject.canBlockUsers(chat);
+    }
+
+    /** A member's perks, from the participants the full chat keeps */
+    public static TLRPC.TL_chatMemberTagPerks findMemberPerks(int account, long chatId, long userId) {
+        final TLRPC.ChatFull chatFull = MessagesController.getInstance(account).getChatFull(chatId);
+        if (chatFull == null || chatFull.participants == null || chatFull.participants.participants == null) return null;
+        for (TLRPC.ChatParticipant participant : chatFull.participants.participants) {
+            if (participant instanceof TLRPC.TL_chatChannelParticipant && participant.user_id == userId) {
+                final TLRPC.ChannelParticipant channelParticipant = ((TLRPC.TL_chatChannelParticipant) participant).channelParticipant;
+                return channelParticipant != null ? channelParticipant.tag_perks : null;
+            }
+        }
+        return null;
+    }
+
+    /** Gives a member perks, or takes them away with perks == null */
+    public static void edit(int account, TLRPC.Chat chat, TLRPC.User user, TLRPC.TL_chatMemberTagPerks perks, Utilities.Callback<TLRPC.TL_error> done) {
+        final MessagesController messagesController = MessagesController.getInstance(account);
+        final TLRPC.TL_channels_editMemberTagPerks req = new TLRPC.TL_channels_editMemberTagPerks();
+        req.channel = MessagesController.getInputChannel(chat);
+        req.participant = MessagesController.getInputPeer(user);
+        req.perks = perks;
+        ConnectionsManager.getInstance(account).sendRequestTyped(req, AndroidUtilities::runOnUIThread, (res, err) -> {
+            if (res != null) {
+                messagesController.processUpdates(res, false);
+            }
+            if (done != null) {
+                done.run(err);
+            }
+        });
+    }
+}
