diff --git a/submodules/TelegramCore/Sources/SyncCore/SyncCore_TelegramChatMemberTagPerks.swift b/submodules/TelegramCore/Sources/SyncCore/SyncCore_TelegramChatMemberTagPerks.swift
new file mode 100644
index 0000000..fcae184
--- /dev/null
+++ b/submodules/TelegramCore/Sources/SyncCore/SyncCore_TelegramChatMemberTagPerks.swift
@@ -0,0 +1,74 @@
+import Foundation
+import Postbox
+import FlatBuffers
+import FlatSerialization
+
+/// Blue Tag (see SPEC.md): perks an admin gave a member together with a member tag —
+/// free messages in a group with paid messages, a personal slow mode, for a time or a number of messages.
+public struct TelegramChatMemberTagPerks: Codable, Equatable {
+    public var freeMessages: Bool
+    public var slowmodeSeconds: Int32
+    public var untilDate: Int32
+    public var messagesLimit: Int32
+    public var messagesUsed: Int32
+
+    public init(freeMessages: Bool, slowmodeSeconds: Int32 = 0, untilDate: Int32 = 0, messagesLimit: Int32 = 0, messagesUsed: Int32 = 0) {
+        self.freeMessages = freeMessages
+        self.slowmodeSeconds = slowmodeSeconds
+        self.untilDate = untilDate
+        self.messagesLimit = messagesLimit
+        self.messagesUsed = messagesUsed
+    }
+
+    public func isActive(timestamp: Int32) -> Bool {
+        if self.untilDate != 0 && self.untilDate <= timestamp {
+            return false
+        }
+        if self.messagesLimit != 0 && self.messagesUsed >= self.messagesLimit {
+            return false
+        }
+        return true
+    }
+
+    /// nil when there is no limit
+    public var messagesLeft: Int32? {
+        if self.messagesLimit == 0 {
+            return nil
+        }
+        return max(0, self.messagesLimit - self.messagesUsed)
+    }
+
+    public func withOneMoreMessage() -> TelegramChatMemberTagPerks {
+        var result = self
+        result.messagesUsed += 1
+        return result
+    }
+
+    public init(flatBuffersObject: TelegramCore_TelegramChatMemberTagPerks) throws {
+        self.freeMessages = flatBuffersObject.freeMessages
+        self.slowmodeSeconds = flatBuffersObject.slowmodeSeconds
+        self.untilDate = flatBuffersObject.untilDate
+        self.messagesLimit = flatBuffersObject.messagesLimit
+        self.messagesUsed = flatBuffersObject.messagesUsed
+    }
+
+    public func encodeToFlatBuffers(builder: inout FlatBufferBuilder) -> Offset {
+        let start = TelegramCore_TelegramChatMemberTagPerks.startTelegramChatMemberTagPerks(&builder)
+        TelegramCore_TelegramChatMemberTagPerks.add(freeMessages: self.freeMessages, &builder)
+        TelegramCore_TelegramChatMemberTagPerks.add(slowmodeSeconds: self.slowmodeSeconds, &builder)
+        TelegramCore_TelegramChatMemberTagPerks.add(untilDate: self.untilDate, &builder)
+        TelegramCore_TelegramChatMemberTagPerks.add(messagesLimit: self.messagesLimit, &builder)
+        TelegramCore_TelegramChatMemberTagPerks.add(messagesUsed: self.messagesUsed, &builder)
+        return TelegramCore_TelegramChatMemberTagPerks.endTelegramChatMemberTagPerks(&builder, start: start)
+    }
+}
+
+public extension TelegramChannel {
+    /// My Blue Tag perks in this chat while they last
+    func activeTagPerks(timestamp: Int32) -> TelegramChatMemberTagPerks? {
+        guard let tagPerks = self.tagPerks, tagPerks.isActive(timestamp: timestamp) else {
+            return nil
+        }
+        return tagPerks
+    }
+}
