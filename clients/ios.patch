 }
 
 
+
+// MARK: - Blue Tag (see SPEC.md)
+
+public enum UpdateChatMemberTagPerksError {
+    case generic
+    case chatAdminRequired
+    case rankEmpty
+    case participantAdmin
+    case invalid
+}
+
+/// Gives a member Blue Tag perks, or takes them away with `perks == nil`. The tag itself stays.
+func _internal_updateChatMemberTagPerks(account: Account, peerId: PeerId, userId: PeerId, perks: TelegramChatMemberTagPerks?) -> Signal<Never, UpdateChatMemberTagPerksError> {
+    return account.postbox.transaction { transaction -> (Api.InputChannel, Api.InputPeer)? in
+        guard let peer = transaction.getPeer(peerId), let inputChannel = apiInputChannel(peer), let user = transaction.getPeer(userId), let inputUser = apiInputPeer(user) else {
+            return nil
+        }
+        return (inputChannel, inputUser)
+    }
+    |> castError(UpdateChatMemberTagPerksError.self)
+    |> mapToSignal { inputs -> Signal<Never, UpdateChatMemberTagPerksError> in
+        guard let (inputChannel, inputUser) = inputs else {
+            return .fail(.generic)
+        }
+        var flags: Int32 = 0
+        if perks != nil {
+            flags |= 1 << 0
+        }
+        return account.network.request(Api.functions.channels.editMemberTagPerks(flags: flags, channel: inputChannel, participant: inputUser, perks: perks?.apiPerks))
+        |> mapError { error -> UpdateChatMemberTagPerksError in
+            switch error.errorDescription {
+            case "CHAT_ADMIN_REQUIRED":
+                return .chatAdminRequired
+            case "TAG_PERKS_RANK_EMPTY":
+                return .rankEmpty
+            case "TAG_PERKS_PARTICIPANT_ADMIN":
+                return .participantAdmin
+            case "TAG_PERKS_INVALID":
+                return .invalid
+            default:
+                return .generic
+            }
+        }
+        |> mapToSignal { updates -> Signal<Never, UpdateChatMemberTagPerksError> in
+            account.stateManager.addUpdates(updates)
+            return .complete()
+        }
+    }
+}
+
+/// A member's current Blue Tag perks, for the Edit Member Tag screen.
+func _internal_chatMemberTagPerks(account: Account, peerId: PeerId, userId: PeerId) -> Signal<TelegramChatMemberTagPerks?, NoError> {
+    return account.postbox.transaction { transaction -> (Api.InputChannel, Api.InputPeer)? in
+        guard let peer = transaction.getPeer(peerId), let inputChannel = apiInputChannel(peer), let user = transaction.getPeer(userId), let inputUser = apiInputPeer(user) else {
+            return nil
+        }
+        return (inputChannel, inputUser)
+    }
+    |> mapToSignal { inputs -> Signal<TelegramChatMemberTagPerks?, NoError> in
+        guard let (inputChannel, inputUser) = inputs else {
+            return .single(nil)
+        }
+        return account.network.request(Api.functions.channels.getParticipant(channel: inputChannel, participant: inputUser))
+        |> map(Optional.init)
+        |> `catch` { _ -> Signal<Api.channels.ChannelParticipant?, NoError> in
+            return .single(nil)
+        }
+        |> map { result -> TelegramChatMemberTagPerks? in
+            guard case let .channelParticipant(data)? = result else {
+                return nil
+            }
+            switch data.participant {
+            case let .channelParticipant(participantData):
+                return participantData.tagPerks.flatMap(TelegramChatMemberTagPerks.init(apiPerks:))
+            default:
+                return nil
+            }
+        }
+    }
+}
+
