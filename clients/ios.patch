diff --git a/submodules/TelegramCore/FlatSerialization/Models/TelegramChatMemberTagPerks.fbs b/submodules/TelegramCore/FlatSerialization/Models/TelegramChatMemberTagPerks.fbs
new file mode 100644
index 0000000..e84df0a
--- /dev/null
+++ b/submodules/TelegramCore/FlatSerialization/Models/TelegramChatMemberTagPerks.fbs
@@ -0,0 +1,10 @@
+namespace TelegramCore;
+
+// Blue Tag (see SPEC.md): perks an admin gave with a member tag
+table TelegramChatMemberTagPerks {
+    freeMessages:bool (id: 0);
+    slowmodeSeconds:int32 (id: 1);
+    untilDate:int32 (id: 2);
+    messagesLimit:int32 (id: 3);
+    messagesUsed:int32 (id: 4);
+}
diff --git a/submodules/TelegramCore/Sources/ApiUtils/ApiChatMemberTagPerks.swift b/submodules/TelegramCore/Sources/ApiUtils/ApiChatMemberTagPerks.swift
new file mode 100644
index 0000000..2236d41
--- /dev/null
+++ b/submodules/TelegramCore/Sources/ApiUtils/ApiChatMemberTagPerks.swift
@@ -0,0 +1,42 @@
+import Foundation
+import Postbox
+internal import TelegramApi
+
+// Blue Tag (see SPEC.md): conversions of chatMemberTagPerks
+extension TelegramChatMemberTagPerks {
+    init(apiPerks: Api.ChatMemberTagPerks) {
+        switch apiPerks {
+        case let .chatMemberTagPerks(data):
+            self.init(
+                freeMessages: (data.flags & (1 << 0)) != 0,
+                slowmodeSeconds: data.slowmodeSeconds ?? 0,
+                untilDate: data.untilDate ?? 0,
+                messagesLimit: data.messagesLimit ?? 0,
+                messagesUsed: data.messagesUsed ?? 0
+            )
+        }
+    }
+
+    var apiPerks: Api.ChatMemberTagPerks {
+        var flags: Int32 = 0
+        if self.freeMessages {
+            flags |= 1 << 0
+        }
+        if self.slowmodeSeconds != 0 {
+            flags |= 1 << 1
+        }
+        if self.untilDate != 0 {
+            flags |= 1 << 2
+        }
+        if self.messagesLimit != 0 {
+            flags |= 1 << 3
+        }
+        return .chatMemberTagPerks(.init(
+            flags: flags,
+            slowmodeSeconds: self.slowmodeSeconds != 0 ? self.slowmodeSeconds : nil,
+            untilDate: self.untilDate != 0 ? self.untilDate : nil,
+            messagesLimit: self.messagesLimit != 0 ? self.messagesLimit : nil,
+            messagesUsed: nil
+        ))
+    }
+}
