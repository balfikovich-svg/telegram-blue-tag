+void SaveMemberTagPerks(
+		std::shared_ptr<Ui::Show> show,
+		not_null<ChannelData*> channel,
+		not_null<UserData*> user,
+		std::optional<Data::ChannelTagPerks> perks) {
+	using Flag = MTPchannels_EditMemberTagPerks::Flag;
+	channel->session().api().request(MTPchannels_EditMemberTagPerks(
+		MTP_flags(perks ? Flag::f_perks : Flag()),
+		channel->inputChannel(),
+		user->input(),
+		Data::SerializeTagPerks(perks.value_or(Data::ChannelTagPerks()))
+	)).done([=](const MTPUpdates &result) {
+		channel->session().api().applyUpdates(result);
+		if (show && perks) {
+			show->showToast(tr::lng_blue_tag_saved(tr::now));
+		}
+	}).fail([=](const MTP::Error &error) {
+		if (show) {
+			show->showToast(error.type());
+		}
+	}).send();
+}
