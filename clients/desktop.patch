+namespace {
+
+constexpr auto kBlueTagDay = TimeId(86400);
+
+struct BlueTagPerksState {
+	Ui::Checkbox *blue = nullptr;
+	Ui::Checkbox *free = nullptr;
+	std::shared_ptr<Ui::RadiobuttonGroup> slowmode;
+	std::shared_ptr<Ui::RadiobuttonGroup> duration;
+	std::shared_ptr<Ui::RadiobuttonGroup> limit;
+	std::optional<Data::ChannelTagPerks> initial;
+
+	[[nodiscard]] std::optional<Data::ChannelTagPerks> current() const {
+		if (!blue->checked()) {
+			return std::nullopt;
+		}
+		const auto duration = this->duration->current();
+		return Data::ChannelTagPerks{
+			.freeMessages = free->checked(),
+			.slowmodeSeconds = slowmode->current(),
+			.until = duration ? (base::unixtime::now() + duration) : 0,
+			.messagesLimit = limit->current(),
+		};
+	}
+};
+
+[[nodiscard]] BlueTagPerksState *AddBlueTagSection(
+		not_null<Ui::GenericBox*> box,
+		not_null<PeerData*> peer,
+		not_null<UserData*> user,
+		HistoryView::BadgeRole role,
+		bool isSelf,
+		not_null<EditTagControl*> control) {
+	const auto channel = peer->asChannel();
+	if (!channel
+		|| !channel->isMegagroup()
+		|| isSelf
+		|| !channel->canBanMembers()
+		|| (role != HistoryView::BadgeRole::User)) {
+		return nullptr;
+	}
+	const auto state = box->lifetime().make_state<BlueTagPerksState>();
+	const auto container = box->verticalLayout();
+	state->blue = container->add(
+		object_ptr<Ui::Checkbox>(
+			container,
+			tr::lng_blue_tag_section(tr::now),
+			false,
+			st::rightsCheckbox,
+			std::make_unique<Ui::ToggleView>(st::rightsToggle, false)),
+		st::rightsToggleMargin);
+	const auto options = container->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			container,
+			object_ptr<Ui::VerticalLayout>(container)));
+	options->toggle(false, anim::type::instant);
+	const auto inner = options->entity();
+	state->free = inner->add(
+		object_ptr<Ui::Checkbox>(
+			inner,
+			tr::lng_blue_tag_free(tr::now),
+			true,
+			st::rightsCheckbox,
+			std::make_unique<Ui::ToggleView>(st::rightsToggle, true)),
+		st::rightsToggleMargin);
+	Ui::AddDividerText(
+		inner,
+		tr::lng_blue_tag_about(lt_name, rpl::single(user->shortName())));
+
+	const auto addGroup = [&](
+			rpl::producer<QString> title,
+			int initial,
+			std::vector<std::pair<int, QString>> variants) {
+		Ui::AddSubsectionTitle(inner, std::move(title));
+		const auto group = std::make_shared<Ui::RadiobuttonGroup>(initial);
+		for (const auto &[value, text] : variants) {
+			inner->add(
+				object_ptr<Ui::Radiobutton>(
+					inner,
+					group,
+					value,
+					text,
+					st::defaultCheckbox),
+				st::rightsToggleMargin);
+		}
+		return group;
+	};
+	const auto seconds = [](int value) {
+		return tr::lng_blue_tag_seconds(tr::now, lt_value, QString::number(value));
+	};
+	const auto minutes = [](int value) {
+		return tr::lng_blue_tag_minutes(tr::now, lt_value, QString::number(value));
+	};
+	state->slowmode = addGroup(tr::lng_blue_tag_slowmode(), 30, {
+		{ 0, tr::lng_blue_tag_off(tr::now) },
+		{ 10, seconds(10) },
+		{ 30, seconds(30) },
+		{ 60, minutes(1) },
+		{ 300, minutes(5) },
+	});
+	state->duration = addGroup(tr::lng_blue_tag_duration(), 7 * kBlueTagDay, {
+		{ kBlueTagDay, tr::lng_blue_tag_day1(tr::now) },
+		{ 7 * kBlueTagDay, tr::lng_blue_tag_days7(tr::now) },
+		{ 0, tr::lng_blue_tag_forever(tr::now) },
+	});
+	state->limit = addGroup(tr::lng_blue_tag_limit(), 50, {
+		{ 10, u"10"_q },
+		{ 50, u"50"_q },
+		{ 0, tr::lng_blue_tag_no_limit(tr::now) },
+	});
+
+	state->blue->checkedChanges(
+	) | rpl::on_next([=](bool checked) {
+		options->toggle(checked, anim::type::normal);
+		control->setBlue(checked);
+	}, state->blue->lifetime());
+
+	// The member's current perks, to edit them.
+	channel->session().api().request(MTPchannels_GetParticipant(
+		channel->inputChannel(),
+		user->input()
+	)).done(crl::guard(box, [=](
+			const MTPchannels_ChannelParticipant &result) {
+		const auto &participant = result.data().vparticipant();
+		const auto perks = participant.match([](
+				const MTPDchannelParticipant &data)
+		-> const MTPChatMemberTagPerks* {
+			const auto perks = data.vtag_perks();
+			return perks ? &*perks : nullptr;
+		}, [](const auto &) -> const MTPChatMemberTagPerks* {
+			return nullptr;
+		});
+		if (!perks) {
+			return;
+		}
+		const auto parsed = Data::ParseTagPerks(*perks);
+		if (!parsed.active(base::unixtime::now())) {
+			return;
+		}
+		state->initial = parsed;
+		state->free->setChecked(parsed.freeMessages);
+		state->slowmode->setValue(parsed.slowmodeSeconds);
+		state->duration->setValue(!parsed.until
+			? 0
+			: (parsed.until - base::unixtime::now() > kBlueTagDay)
+			? 7 * kBlueTagDay
+			: kBlueTagDay);
+		state->limit->setValue(parsed.messagesLimit);
+		state->blue->setChecked(true);
+		// What was loaded is the starting point, rounded to the variants.
+		state->initial = state->current();
+		if (state->initial) {
+			state->initial->until = parsed.until;
+		}
+	})).send();
+
+	return state;
+}
+
