+namespace Data {
+
+ChannelTagPerks ParseTagPerks(const MTPChatMemberTagPerks &data) {
+	const auto &fields = data.data();
+	return {
+		.freeMessages = fields.is_free_messages(),
+		.slowmodeSeconds = fields.vslowmode_seconds().value_or_empty(),
+		.until = fields.vuntil_date().value_or_empty(),
+		.messagesLimit = fields.vmessages_limit().value_or_empty(),
+		.messagesUsed = fields.vmessages_used().value_or_empty(),
+	};
+}
+
+MTPChatMemberTagPerks SerializeTagPerks(const ChannelTagPerks &perks) {
+	using Flag = MTPDchatMemberTagPerks::Flag;
+	return MTP_chatMemberTagPerks(
+		MTP_flags((perks.freeMessages ? Flag::f_free_messages : Flag())
+			| (perks.slowmodeSeconds ? Flag::f_slowmode_seconds : Flag())
+			| (perks.until ? Flag::f_until_date : Flag())
+			| (perks.messagesLimit ? Flag::f_messages_limit : Flag())),
+		MTP_int(perks.slowmodeSeconds),
+		MTP_int(perks.until),
+		MTP_int(perks.messagesLimit),
+		MTP_int(0));
+}
+
+} // namespace Data
+
+void ChannelData::setMyTagPerks(std::optional<Data::ChannelTagPerks> perks) {
+	if (_myTagPerks == perks) {
+		return;
+	}
+	_myTagPerks = perks;
+	session().changes().peerUpdated(
+		this,
+		UpdateFlag::Rights | UpdateFlag::Slowmode);
+}
+
+const Data::ChannelTagPerks *ChannelData::myActiveTagPerks() const {
+	return (_myTagPerks && _myTagPerks->active(base::unixtime::now()))
+		? &*_myTagPerks
+		: nullptr;
+}
+
+void ChannelData::countMyTagPerksMessage() {
+	if (myActiveTagPerks()) {
+		++_myTagPerks->messagesUsed;
+		session().changes().peerUpdated(this, UpdateFlag::Rights);
+	}
+}
