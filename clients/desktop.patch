+// Blue Tag (see SPEC.md): perks an admin gave with a member tag.
+struct ChannelTagPerks {
+	bool freeMessages = false;
+	int slowmodeSeconds = 0;
+	TimeId until = 0;
+	int messagesLimit = 0;
+	int messagesUsed = 0;
+
+	[[nodiscard]] bool active(TimeId now) const {
+		return (!until || until > now)
+			&& (!messagesLimit || messagesUsed < messagesLimit);
+	}
+	[[nodiscard]] int messagesLeft() const {
+		return messagesLimit
+			? std::max(messagesLimit - messagesUsed, 0)
+			: -1;
+	}
+
+	friend inline bool operator==(
+		const ChannelTagPerks &,
+		const ChannelTagPerks &) = default;
+};
+
+[[nodiscard]] ChannelTagPerks ParseTagPerks(
+	const MTPChatMemberTagPerks &data);
+[[nodiscard]] MTPChatMemberTagPerks SerializeTagPerks(
+	const ChannelTagPerks &perks);
+
 } // namespace Data
 
